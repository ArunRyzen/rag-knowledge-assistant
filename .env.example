# Copy to `.env` and fill in the two API keys.

# ── Gemini (required) ── one free key covers embeddings AND answers.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_MODEL=gemini-2.5-flash
MAX_TOKENS=1024

# ── Vector store ── memory (in-process, nothing persists between runs) or pinecone.
# For pinecone: create a serverless index with dimension 768 and metric cosine at
# https://app.pinecone.io, put your API key here, then run `rag ingest` once.
VECTOR_STORE=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=rag-assistant

# ── Retrieval tuning ──
TOP_K=5
CANDIDATE_K=20
USE_RERANKER=false
RRF_K=60

# ── Chunking ──
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ── Learning aid ── set to 1 to print every AI request/response (prompts, previews, answers —
# never keys) to stderr. Empty, 0, or false = off. A real LLM_DEBUG environment variable — when
# set at all — always wins over this file.
LLM_DEBUG=
